# ─────────────────────────────────────────────────────────
# Backend Environment Variables — Skill2Job
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────

# Flask
FLASK_CONFIG=development
SECRET_KEY=change-this-to-a-random-secret-key
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret
JWT_TOKEN_EXPIRY_MINUTES=60

# MySQL Database
# Format: mysql+pymysql://user:password@host:port/dbname
DATABASE_URL=mysql+pymysql://root:yourpassword@127.0.0.1:3306/skillbridge

# SpaCy NLP Model
SPACY_MODEL=en_core_web_sm

# File Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:3000

# Email / SMTP (leave empty to log emails in development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@skillbridge.com
FROM_NAME=Skill2Job
